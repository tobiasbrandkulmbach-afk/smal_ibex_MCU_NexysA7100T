// IMEM init - hand-assembled RV32I machine code.
// Ibex Reset-Vektor: boot_addr_i + 0x80,  mtvec-Basis: boot_addr_i + 0x00.
// Mit BootAddr=0x0000_0000 liegt _start bei 0x80, Trap-Handler bei 0x00.
//
// Format: $readmemh - jedes 32-Bit-Wort eine Zeile.
// ===========================================================================
//  Byte | Mnemonic                | Hex       | Bedeutung
// ===========================================================================
//  0x00 | jal  x0, _start          | 0800006f  | trap-handler: re-init (PC+=0x80)
0800006f
// --- Padding 0x04..0x7C (NOP = addi x0,x0,0) ---
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
00000013
// ===========================================================================
//                              Hauptprogramm @ 0x80
// ===========================================================================
//  0x80 | lui  a0, 0x00010         | 00010537  | a0 = 0x0001_0000 (DMEM base)
00010537
//  0x84 | lui  a1, 0x80000         | 800005b7  | a1 = 0x8000_0000 (SEG7 base)
800005b7
//  0x88 | lui  a2, 0x00001         | 00001637  | a2 = 0x0000_1000 (4096 = count)
00001637
//  0x8C | addi t0, x0,  0          | 00000293  | _restart: t0 = i = 0
00000293
//  0x90 | slli t1, t0,  2          | 00229313  | _loop:    t1 = i*4
00229313
//  0x94 | add  t1, a0, t1          | 00650333  |           t1 = &dmem[i]
00650333
//  0x98 | lw   t2, 0(t1)           | 00032383  |           t2 = dmem[i]
00032383
//  0x9C | sw   t2, 0(a1)           | 0075a023  |           *seg7 = t2
0075a023
//  0xA0 | lui  t3, 0x00100         | 00100e37  |           delay = 0x0010_0000 (~1.05M, ~25 ms/Wert)
00100e37
//  0xA4 | addi t3, t3, -1          | fffe0e13  | _delay:   t3--
fffe0e13
//  0xA8 | bne  t3, x0, _delay      | fe0e1ee3  |           if (t3 != 0) -> _delay  (-4)
fe0e1ee3
//  0xAC | addi t0, t0,  1          | 00128293  |           i++
00128293
//  0xB0 | bne  t0, a2, _loop       | fec290e3  |           if (i != 4096) -> _loop  (-0x20)
fec290e3
//  0xB4 | jal  x0, _restart        | fd9ff06f  |           else -> _restart        (-0x28)
fd9ff06f
// --- Rest des IMEM (0xB8..0x3FC, 210 Woerter) - NOPs.  Wird nie erreicht. ---
