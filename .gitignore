# ---- Questa / ModelSim ----
work/
transcript
vsim.wlf
*.vstf

# ---- Vivado ----
.Xil/
*.jou
*.log
*.backup.jou
*.backup.log
*.str
*.dir/
.Xil-pid*
fsm_encoding.os
usage_statistics_webtalk.*
webtalk*.xml

# Vivado build outputs: out/ wird getrackt, aber nur die Bitstreams (Binaries).
# Der Rest (Checkpoints .dcp, .mmi, Reports, .mem-Kopien, .Xil, Journale) bleibt
# ignoriert.
deployments/*/out/*
!deployments/*/out/.gitkeep
!deployments/*/out/*.bit
!deployments/*/out/*.mcs

# ---- Firmware (CMake) ----
# CMake-Build-Verzeichnisse der Firmware
deployments/*/firmware/build/

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*~

# ---- Claude Code session data ----
.claude/

# ---- OS junk ----
.DS_Store
Thumbs.db

# ---- Vivado debug byproducts (in cwd) ----
clockInfo.txt
tight_setup_hold_pins.txt
